// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id                   String    @id @db.Uuid
  title                String
  description          String
  imageUrl             String    @map("image_url")
  slideshowImageUrl    String    @map("slideshow_image_url")
  blobImageUrl         String?   @map("blob_image_url")
  blobSlideshowImageUrl String?  @map("blob_slideshow_image_url")
  instagramUrl         String    @map("instagram_url")
  locationName         String    @map("location_name")
  countryName          String    @map("country_name")
  isFilm               Boolean   @default(true) @map("is_film")
  takenOn              DateTime? @map("taken_on") @db.Date
  lat                  Float
  lng                  Float
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("photos")
}
